+        SDL_LogError(SDL_LOG_CATEGORY_APPLICATION,
+                     "Cannot open GLSL file: %s",
+                     path.toUtf8().constData());
+        return {};
+    }
+
+    QByteArray data = file.readAll();
+    return std::string(data.constData(), data.size());
+}
