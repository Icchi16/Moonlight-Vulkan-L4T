+void PlVkRenderer::setFsrSharpness(const pl_hook* hook, float stops)
+{
+    if (hook == nullptr) {
+        return;
+    }
+
+    for (int i = 0; i < hook->num_parameters; i++) {
+        const pl_hook_par& par = hook->parameters[i];
+        if (par.type == PL_VAR_FLOAT && strcmp(par.name, "SHARPNESS") == 0) {
+            par.data->f = SDL_max(par.minimum.f, SDL_min(stops, par.maximum.f));
+            return;
+        }
+    }
+
+    SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                "FSR1 shader has no SHARPNESS parameter");
+}
